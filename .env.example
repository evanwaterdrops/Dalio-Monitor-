# --- required ---
FRED_API_KEY=            # free: fred.stlouisfed.org/docs/api/api_key.html
OANDA_API_KEY=           # OANDA v20 personal access token
OANDA_ACCOUNT_ID=        # e.g. 101-011-1234567-001
OANDA_ENV=practice       # practice | live
CRON_SECRET=             # any random string; Vercel Cron sends it as Bearer

# --- optional ---
SUPABASE_URL=            # created via Supabase connector; app runs stateless without it
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=       # enables the "what changed" narrative paragraphs
